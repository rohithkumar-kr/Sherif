<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  The local SHERIF backend speaks plain http on the development machine, and
  Android blocks cleartext by default from API 28 onwards. Rather than
  switching cleartext on globally, it is enabled for exactly the loopback
  addresses a developer uses:

    10.0.2.2    the emulator's alias for the host machine
    localhost   an app running on the device itself
    127.0.0.1   ditto, and the address the JVM test suite uses

  Every other destination, in a debug build and in a release build alike,
  still requires https. Release builds do not contain this file or the
  attribute that points at it, so this is a development convenience and never
  a production weakening.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
