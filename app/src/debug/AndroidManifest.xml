<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build manifest overlay.

  It exists for a single reason: to attach the cleartext network security
  config that lets a debug build reach a SHERIF backend running on the
  development machine. The main manifest does not set
  `android:networkSecurityConfig`, so there is nothing to replace here, and
  the attribute is simply absent from release builds.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application android:networkSecurityConfig="@xml/network_security_config" />

</manifest>
